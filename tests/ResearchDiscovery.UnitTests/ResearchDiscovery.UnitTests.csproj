<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ResearchDiscovery.Infrastructure\ResearchDiscovery.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- The real eval ground truth, not a copy: EvalQueryFixtureTests guards
         the checked-in artifact itself, so it must not drift from a duplicate. -->
    <None Include="..\..\eval\queries.json" Link="Fixtures\eval-queries.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
